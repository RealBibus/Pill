<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Pill.Installer</AssemblyName>
    <RootNamespace>Pill.Installer</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <Authors>RealBibus</Authors>
    <Description>Pill installer</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Pill\Native\WindowEffects.cs" Link="Native\WindowEffects.cs" />
  </ItemGroup>

</Project>
