<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="InstallerAccent" Color="#FF5B8CFF"/>
    <SolidColorBrush x:Key="InstallerText" Color="#FFF2F5FF"/>
    <SolidColorBrush x:Key="InstallerMuted" Color="#FF99A0B3"/>
    <SolidColorBrush x:Key="InstallerCard" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="InstallerHover" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="InstallerIdle" Color="#00FFFFFF"/>

    <Style x:Key="InstallerButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource InstallerIdle}"/>
        <Setter Property="Foreground" Value="{StaticResource InstallerText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource InstallerHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
