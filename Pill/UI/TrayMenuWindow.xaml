<Window x:Class="Pill.UI.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pill"
        Width="310"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="MenuHoverBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="MenuPressBrush" Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="MenuIdleBrush" Color="#00FFFFFF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="#66FFFFFF"/>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="6" Background="Transparent">
                            <Border Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                    CornerRadius="1" Background="#22FFFFFF"/>
                            <Track x:Name="PART_Track" Width="6" HorizontalAlignment="Center" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"
                                                  IsTabStop="False" Opacity="0" Height="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="4" Margin="1,0,1,0" CornerRadius="2"
                                                        Background="#66FFFFFF"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"
                                                  IsTabStop="False" Opacity="0" Height="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="10" Background="#33FFFFFF"/>
                            <Border x:Name="TrackOn" CornerRadius="10" Opacity="0"
                                    Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                            <Ellipse x:Name="Knob" Width="12" Height="12" Fill="#FFB9B9BE"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(Ellipse.Fill).(SolidColorBrush.Color)"
                                                            To="#FFFFFFFF" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(Ellipse.Fill).(SolidColorBrush.Color)"
                                                            To="#FFB9B9BE" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource MenuIdleBrush}"/>
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource MenuPressBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuInput" TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
            <Setter Property="CaretBrush" Value="#F2FFFFFF"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SubItemLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
        </Style>
        <Style x:Key="SectionValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,4"/>
        </Style>

        <Style x:Key="PopPanel" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                        <TranslateTransform Y="10"/>
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                             To="0" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="12"
            Background="#38141418"
            BorderBrush="#2AFFFFFF"
            BorderThickness="1"
            Padding="12,10,12,10">
        <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="AMBIENT" Style="{StaticResource GroupHeader}"/>
                <Border Style="{StaticResource PopPanel}" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,7">
                    <StackPanel>
                        <Border x:Name="AmbientHit" Background="Transparent" MouseLeftButtonUp="AmbientHit_MouseUp" Cursor="Hand">
                            <Grid Height="22">
                                <TextBlock Text="Cover art color" Style="{StaticResource SubItemLabel}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock x:Name="AmbientValue" Text="Off" Style="{StaticResource SectionValue}"/>
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Margin="6,1,0,0" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Margin="0,2,0,2">
                            <TextBlock Text="Accent" Style="{StaticResource SubItemLabel}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Width="14" Height="14" CornerRadius="7" Margin="0,0,8,0"
                                        Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" BorderBrush="#33000000" BorderThickness="1"/>
                                <TextBlock x:Name="AccentValue" Text="#5B8CFF" Style="{StaticResource SectionValue}"/>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="ResetAccentButton" Style="{StaticResource MenuButton}"
                                Content="Reset accent" Margin="0,2,0,0" Click="ResetAccentButton_Click"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="WEATHER" Style="{StaticResource GroupHeader}"/>
                <Border Style="{StaticResource PopPanel}" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,7">
                    <StackPanel>
                        <Grid Height="24">
                            <TextBlock Text="City" Style="{StaticResource SubItemLabel}" VerticalAlignment="Center"/>
                            <TextBox x:Name="WeatherCityBox" Style="{StaticResource MenuInput}" Width="156"
                                     HorizontalAlignment="Right" TextChanged="WeatherField_TextChanged"/>
                        </Grid>
                        <Grid Height="24" Margin="0,4,0,0">
                            <TextBlock Text="Country code" Style="{StaticResource SubItemLabel}" VerticalAlignment="Center"/>
                            <TextBox x:Name="WeatherCountryBox" Style="{StaticResource MenuInput}" Width="156"
                                     HorizontalAlignment="Right" TextChanged="WeatherField_TextChanged"/>
                        </Grid>
                        <Grid Height="22" Margin="0,4,0,0">
                            <TextBlock Text="Device location" Style="{StaticResource SubItemLabel}" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" x:Name="DeviceLocationToggle" Style="{StaticResource SwitchToggle}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Height="24" Margin="0,4,0,0">
                            <TextBlock Text="Units" Style="{StaticResource SubItemLabel}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="CelsiusButton" Style="{StaticResource MenuButton}" Tag="C"
                                        Content="°C" Width="40" Padding="6,3" Click="UnitButton_Click"/>
                                <Button x:Name="FahrenheitButton" Style="{StaticResource MenuButton}" Tag="F"
                                        Content="°F" Width="40" Padding="6,3" Margin="4,0,0,0" Click="UnitButton_Click"/>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="DetectLocationButton" Style="{StaticResource MenuButton}"
                                Content="Detect my location" Margin="0,5,0,0" Click="DetectLocationButton_Click"/>
                        <Grid Height="18" Margin="0,3,0,0">
                            <TextBlock x:Name="WeatherLocationText" Text="Detecting location"
                                       Style="{StaticResource SubItemLabel}" FontSize="10"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,70,0"/>
                            <TextBlock x:Name="WeatherValueText" Text="--°C" Style="{StaticResource SectionValue}"
                                       FontSize="10.5"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="SYSTEM" Style="{StaticResource GroupHeader}"/>
                <Border Style="{StaticResource PopPanel}" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,7">
                    <StackPanel>
                        <Grid Height="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Start with Windows" Style="{StaticResource SubItemLabel}" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" x:Name="AutoStartToggle" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Height="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto updates" Style="{StaticResource SubItemLabel}" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" x:Name="AutoUpdateToggle" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Height="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hide in fullscreen games" Style="{StaticResource SubItemLabel}" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" x:Name="HideInGamesToggle" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="UPDATES" Style="{StaticResource GroupHeader}"/>
                <Border Style="{StaticResource PopPanel}" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,7">
                    <StackPanel>
                        <Grid Height="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Beta channel" Style="{StaticResource SubItemLabel}" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" x:Name="BetaToggle" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                        </Grid>
                        <Border x:Name="CheckUpdateHit" Background="Transparent" MouseLeftButtonUp="CheckUpdateHit_MouseUp" Cursor="Hand">
                            <Grid Height="22">
                                <TextBlock Text="Check for updates" Style="{StaticResource SubItemLabel}"/>
                                <TextBlock x:Name="UpdateStatusValue" Text="Idle" Style="{StaticResource SectionValue}"/>
                            </Grid>
                        </Border>
                        <Border x:Name="UpdateCard" Visibility="Collapsed" Style="{StaticResource PopPanel}"
                                Background="#14FFFFFF" CornerRadius="6" Padding="8" Margin="0,5,0,0">
                            <StackPanel>
                                <TextBlock x:Name="UpdateVersionText" Foreground="#F2FFFFFF" FontSize="12.5" FontWeight="SemiBold"/>
                                <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,4,0,6">
                                    <TextBlock x:Name="UpdateNotesText" Foreground="#99FFFFFF" FontSize="11.5" TextWrapping="Wrap"/>
                                </ScrollViewer>
                                <ProgressBar x:Name="UpdateProgress" Height="4" Minimum="0" Maximum="1"
                                             Background="#33FFFFFF" BorderThickness="0"
                                             Foreground="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="0,0,0,6"/>
                                <Button x:Name="UpdateNowButton" Style="{StaticResource MenuButton}"
                                        Content="Update &amp; restart" Margin="0,0,0,2"/>
                                <Button x:Name="DeferButton" Style="{StaticResource MenuButton}"
                                        Content="Install on shutdown"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Button x:Name="ShowHideButton" Style="{StaticResource MenuButton}" Content="Show / hide" Margin="0,0,0,2"
                        Click="ShowHideButton_Click"/>
                <Button x:Name="ClearShelfButton" Style="{StaticResource MenuButton}" Content="Clear shelf" Margin="0,0,0,2"
                        Click="ClearShelfButton_Click"/>
                <Button x:Name="QuitButton" Style="{StaticResource MenuButton}" Content="Quit" Click="QuitButton_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
