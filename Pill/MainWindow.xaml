<Window x:Class="Pill.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Pill.Controls"
        Title="Pill"
        Width="480" Height="330"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        SnapsToDevicePixels="False">

    <Grid x:Name="Root"
          MouseLeftButtonDown="Root_MouseLeftButtonDown"
          DragEnter="Root_DragEnter"
          DragOver="Root_DragOver"
          DragLeave="Root_DragLeave"
          Drop="Root_Drop">

        
        <Border Height="66" VerticalAlignment="Top" Background="Transparent"
                DragEnter="Root_DragEnter"
                DragOver="Root_DragOver"
                DragLeave="Root_DragLeave"
                Drop="Root_Drop" />

        
        <Border x:Name="Pill"
                Width="380" Height="66"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0"
                CornerRadius="30"
                Background="{StaticResource PillBackground}"
                BorderBrush="#18FFFFFF" BorderThickness="1"
                MouseEnter="Root_MouseEnter"
                MouseLeave="Root_MouseLeave">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="10" ShadowDepth="2" />
            </Border.Effect>

            <Border CornerRadius="29" ClipToBounds="True">
                <Grid>

                    
                    <Border CornerRadius="29" IsHitTestVisible="False"
                            Background="{Binding AccentBackgroundBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Opacity="0.16" />

                    
                    <Border Height="1" VerticalAlignment="Top" Margin="44,0,44,0" IsHitTestVisible="False" Opacity="0.6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="{Binding AccentBrush.Color, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                              Offset="0.5" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    
                    <Grid x:Name="CompactRoot" Height="50" Margin="16,0,16,0"
                          VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="6" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="9" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="124" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Width="40" Height="40" CornerRadius="12" Background="#14FFFFFF"
                                BorderBrush="#20FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="♫" FontSize="15" Foreground="#9A9A9A"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding Media.Cover}" Stretch="UniformToFill">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,40,40" RadiusX="12" RadiusY="12" />
                                    </Image.Clip>
                                </Image>
                                <Border Width="16" Height="16" CornerRadius="8" Panel.ZIndex="2"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                                        Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        Visibility="{Binding HasShelfItems, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding ShelfCount}" FontSize="9" FontWeight="Bold"
                                               Foreground="#FF101010" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,4,0">
                            <TextBlock Text="{Binding Media.Title}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" MaxWidth="168"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Media.Artist}" FontSize="10.5"
                                       Foreground="{StaticResource TextSecondary}" MaxWidth="168"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Status.ClockText}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Weather.Icon}" FontSize="15" Margin="8,0,3,0"
                                           Foreground="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Weather.Temperature}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        
                        <Border Grid.Row="1" Grid.ColumnSpan="4" Height="3" Margin="0,1,0,0" CornerRadius="1.5"
                                Background="#20FFFFFF" ClipToBounds="True" IsHitTestVisible="False">
                            <Border Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Media.Progress}" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>

                    
                    <Grid x:Name="ExpandedRoot" Margin="16,10,16,8" Opacity="0" IsHitTestVisible="False"
                          VerticalAlignment="Top">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="ExpandedShift" Y="8" />
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="72" />
                            <RowDefinition Height="66" />
                            <RowDefinition Height="56" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Media.Source}" Style="{StaticResource Caption}"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                <ItemsControl ItemsSource="{Binding Equalizer.Levels}" Width="28" Height="12"
                                              Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Opacity="0.75"
                                              Visibility="{Binding HasMusic, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="2" Margin="1,0,1,0" CornerRadius="1"
                                                    VerticalAlignment="Bottom" Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    Height="{Binding Converter={StaticResource LevelToHeight}, ConverterParameter=9}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource HeaderButton}" Click="AmbientButton_Click">
                                    <Grid>
                                        <Path Data="{StaticResource IconPalette}" Width="12" Height="12"
                                              Stretch="Uniform" Stroke="{StaticResource TextSecondary}"
                                              StrokeThickness="1.3" />
                                        <Ellipse Width="7" Height="7" HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom" Margin="0,0,0,0"
                                                 Fill="{Binding AmbientColor, Converter={StaticResource ColorToBrush}}"
                                                 Visibility="{Binding AmbientColorEnabled, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource HeaderButton}" Click="CollapseButton_Click" Margin="2,0,0,0">
                                    <Path Data="{StaticResource IconChevron}" Width="12" Height="12" Stretch="Uniform"
                                          Stroke="{StaticResource TextSecondary}" StrokeThickness="1.6" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        
                        <Grid Grid.Row="1" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Status.ClockText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Path Data="{StaticResource IconMouse}" Width="11" Height="11" Stretch="Uniform"
                                      Stroke="{StaticResource TextDim}" StrokeThickness="1.3" />
                                <TextBlock Text="{Binding Status.MouseBattery}" FontSize="10.5"
                                           Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                                <Border Width="1" Height="10" Background="#20FFFFFF" Margin="10,0" />
                                <Path Data="{StaticResource IconHeadphones}" Width="11" Height="11" Stretch="Uniform"
                                      Stroke="{StaticResource TextDim}" StrokeThickness="1.3" />
                                <TextBlock Text="{Binding Status.HeadphonesBattery}" FontSize="10.5"
                                           Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                                <Border Width="1" Height="10" Background="#20FFFFFF" Margin="10,0" />
                                <TextBlock Text="LISTENED" FontSize="9.5" FontWeight="SemiBold"
                                           Foreground="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Status.ListeningText}" FontSize="10"
                                           Foreground="{StaticResource TextPrimary}" Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="2,0,0,0">
                                <Grid Width="4" Height="5" Margin="1,0,0,0" VerticalAlignment="Bottom">
                                    <Border CornerRadius="2,2,1,1" Background="#1CFFFFFF" />
                                    <Border CornerRadius="2,2,1,1"
                                            Visibility="{Binding Status.NetworkBars, Converter={StaticResource LevelToVisibility}, ConverterParameter=1}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="{Binding AccentSoftBrush.Color, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Offset="0" />
                                                <GradientStop Color="{Binding AccentBrush.Color, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <Grid Width="4" Height="7" Margin="2,0,0,0" VerticalAlignment="Bottom">
                                    <Border CornerRadius="2,2,1,1" Background="#1CFFFFFF" />
                                    <Border CornerRadius="2,2,1,1"
                                            Visibility="{Binding Status.NetworkBars, Converter={StaticResource LevelToVisibility}, ConverterParameter=2}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="{Binding AccentSoftBrush.Color, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Offset="0" />
                                                <GradientStop Color="{Binding AccentBrush.Color, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <Grid Width="4" Height="9" Margin="2,0,0,0" VerticalAlignment="Bottom">
                                    <Border CornerRadius="2,2,1,1" Background="#1CFFFFFF" />
                                    <Border CornerRadius="2,2,1,1"
                                            Visibility="{Binding Status.NetworkBars, Converter={StaticResource LevelToVisibility}, ConverterParameter=3}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="{Binding AccentSoftBrush.Color, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Offset="0" />
                                                <GradientStop Color="{Binding AccentBrush.Color, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <Grid Width="4" Height="11" Margin="2,0,0,0" VerticalAlignment="Bottom">
                                    <Border CornerRadius="2,2,1,1" Background="#1CFFFFFF" />
                                    <Border CornerRadius="2,2,1,1"
                                            Visibility="{Binding Status.NetworkBars, Converter={StaticResource LevelToVisibility}, ConverterParameter=4}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="{Binding AccentSoftBrush.Color, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Offset="0" />
                                                <GradientStop Color="{Binding AccentBrush.Color, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        
                        <Grid Grid.Row="2" Margin="0,4,0,0" Height="68">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="168" />
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="52" Height="52" CornerRadius="12" Background="#13FFFFFF"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="♫" FontSize="18" Foreground="#6A6A6A"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Media.Cover}" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,52,52" RadiusX="12" RadiusY="12" />
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center"
                                            Visibility="{Binding HasMusic, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Media.Title}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Media.Artist}" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"
                                               Margin="0,5,0,0" />
                                </StackPanel>

                                <Border Grid.Column="1" CornerRadius="12" Background="#09FFFFFF"
                                        Margin="4,0,0,0"
                                        Visibility="{Binding HasMusic, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                                        <TextBlock Text="No music playing" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="Spotify, browser or Yandex Music" FontSize="10.5"
                                                   Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            
                            <Border Grid.Column="1" Margin="12,0,0,0" CornerRadius="12"
                                    Background="#0AFFFFFF" Padding="10,5,16,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="WEATHER" Style="{StaticResource Caption}" FontSize="9"
                                               Foreground="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" />

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Weather.Icon}" FontSize="24" Width="30"
                                                   Foreground="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   TextAlignment="Center" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Weather.Temperature}" FontSize="24"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                                       HorizontalAlignment="Right" TextAlignment="Right" />
                                            <TextBlock Text="{Binding Weather.Condition}" FontSize="9"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       HorizontalAlignment="Right" TextAlignment="Right"
                                                       Margin="0,2,0,0" MaxWidth="88"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        
                        <Border Grid.Row="3" Margin="0,14,0,0" Height="52" CornerRadius="12"
                                Background="#08FFFFFF" Padding="9,6,9,6"
                                Visibility="{Binding HasMusic, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="3" />
                                    <RowDefinition Height="12" />
                                </Grid.RowDefinitions>

                                <controls:WaveformControl x:Name="Waveform" AudioSource="{Binding Equalizer}"
                                                          VerticalAlignment="Stretch" IsHitTestVisible="False"
                                                          Margin="0,0,0,2" />

                                <Border Grid.Row="1" Height="3" CornerRadius="1.5" Background="#20FFFFFF"
                                        ClipToBounds="True">
                                    <Border Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Media.Progress}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>

                                <Grid Grid.Row="2" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Media.PositionText}" Style="{StaticResource Caption}"
                                               FontSize="9.5" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Media.DurationText}" Style="{StaticResource Caption}"
                                               FontSize="9.5" HorizontalAlignment="Right" />
                                </Grid>
                            </Grid>
                        </Border>

                        
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding HasMusic, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource PlayerButton}" Click="Previous_Click"
                                    IsEnabled="{Binding Media.CanPrevious}">
                                <Path Data="{StaticResource IconPrevious}" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{StaticResource TextPrimary}" />
                            </Button>
                            <Button Style="{StaticResource PrimaryPlayerButton}" Click="PlayPause_Click"
                                    Margin="10,0,10,0">
                                <Grid>
                                    <Path Data="{StaticResource IconPause}" Width="16" Height="16" Stretch="Uniform"
                                          Fill="#FF141414"
                                          Visibility="{Binding Media.IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                                    <Path Data="{StaticResource IconPlay}" Width="16" Height="16" Stretch="Uniform"
                                          Fill="#FF141414"
                                          Visibility="{Binding Media.IsPlaying, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource PlayerButton}" Click="Next_Click"
                                    IsEnabled="{Binding Media.CanNext}">
                                <Path Data="{StaticResource IconNext}" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{StaticResource TextPrimary}" />
                            </Button>
                        </StackPanel>

                        
                        <Grid Grid.Row="5" Height="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Rectangle Grid.Row="0" Height="1" Fill="#14FFFFFF" />
                            <Grid Grid.Row="1" Margin="0,3,0,0">
                                <TextBlock Text="DROPSHELF" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource TinyButton}" Width="22" Height="22"
                                        HorizontalAlignment="Right" Click="ClearShelf_Click"
                                        Visibility="{Binding HasShelfItems, Converter={StaticResource BoolToVisibility}}">
                                    <Path Data="{StaticResource IconTrash}" Width="11" Height="11" Stretch="Uniform"
                                          Stroke="{StaticResource TextSecondary}" StrokeThickness="1.3" />
                                </Button>
                            </Grid>
                        </Grid>

                        <ScrollViewer Grid.Row="6" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasShelfItems, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Shelf}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#11FFFFFF" CornerRadius="10" Padding="6,4,4,4"
                                                Margin="0,0,6,6" Cursor="Hand"
                                                PreviewMouseLeftButtonDown="Chip_PreviewMouseLeftButtonDown"
                                                MouseMove="Chip_MouseMove"
                                                MouseLeftButtonUp="Chip_MouseLeftButtonUp">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Icon}" Width="16" Height="16"
                                                       VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="10.5"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               MaxWidth="122" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SizeText}" FontSize="9"
                                                               Foreground="{StaticResource TextDim}" Margin="0,1,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource TinyButton}"
                                                        Tag="{Binding}" Click="RemoveShelf_Click">
                                                    <Path Data="{StaticResource IconClose}" Width="8" Height="8"
                                                          Stretch="Uniform" Stroke="{StaticResource TextSecondary}"
                                                          StrokeThickness="1.5" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    
                    <Border CornerRadius="29"
                            Background="{Binding AccentSoftBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Opacity="0.03" IsHitTestVisible="False" Panel.ZIndex="4" />

                    
                    <Border CornerRadius="29" ClipToBounds="True" IsHitTestVisible="False" Panel.ZIndex="5">
                        <Border x:Name="Sheen" Width="100" HorizontalAlignment="Left"
                                VerticalAlignment="Stretch" IsHitTestVisible="False" Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                    <GradientStop Color="#3AFFFFFF" Offset="0.5" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="SheenShift" X="-180" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <Border.ContextMenu>
                <ContextMenu Background="#FF060A14" Foreground="{StaticResource TextPrimary}"
                             BorderThickness="0">
                    <MenuItem Header="Show / hide" Click="MenuToggle_Click" />
                    <MenuItem Header="Ambient color" IsCheckable="True"
                              IsChecked="{Binding AmbientColorEnabled, Mode=TwoWay}" />
                    <MenuItem Header="Autostart" IsCheckable="True"
                              IsChecked="{Binding AutoStart, Mode=TwoWay}" />
                    <MenuItem Header="Auto update (beta)" IsCheckable="True"
                              IsChecked="{Binding AutoUpdate, Mode=TwoWay}" />
                    <MenuItem Header="Check for updates" Click="MenuUpdate_Click" />
                    <Separator />
                    <MenuItem Header="Install" Click="MenuInstall_Click" />
                    <MenuItem Header="Uninstall" Click="MenuUninstall_Click" />
                    <Separator />
                    <MenuItem Header="Exit" Click="MenuExit_Click" />
                </ContextMenu>
            </Border.ContextMenu>
        </Border>

        
        <Border x:Name="DropOutline" Width="{Binding ActualWidth, ElementName=Pill}"
                Height="{Binding ActualHeight, ElementName=Pill}"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0"
                CornerRadius="30" BorderThickness="2"
                BorderBrush="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Opacity="0" IsHitTestVisible="False" />
    </Grid>
</Window>
