<Window x:Class="Pill.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Pill.Controls"
        Title="Pill"
        Width="354" Height="84"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        SnapsToDevicePixels="False">

    <Grid x:Name="Root"
          Background="Transparent"
          MouseEnter="Root_MouseEnter"
          MouseLeave="Root_MouseLeave"
          MouseLeftButtonDown="Root_MouseLeftButtonDown"
          DragEnter="Root_DragEnter"
          DragOver="Root_DragOver"
          DragLeave="Root_DragLeave"
          Drop="Root_Drop">

        <!-- Капсула -->
        <Border x:Name="Pill"
                Margin="12"
                CornerRadius="30"
                Background="{StaticResource PillBackground}"
                BorderBrush="{StaticResource PillStroke}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.45" BlurRadius="16" ShadowDepth="6" />
            </Border.Effect>

            <Border CornerRadius="29" ClipToBounds="True">
                <Grid>

                    <!-- Один тонкий блик вместо цветного свечения -->
                    <Border Height="1" VerticalAlignment="Top" Margin="44,0,44,0" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#2EFFFFFF" Offset="0.5" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Свёрнутый режим -->
                    <Grid x:Name="CompactRoot" Height="60" Margin="14,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="34" Height="34" CornerRadius="10" Background="#16FFFFFF"
                                VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="♫" FontSize="16" Foreground="#AAB4C0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding Media.Cover}" Stretch="UniformToFill">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,34,34" RadiusX="10" RadiusY="10" />
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Media.Title}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" MaxWidth="128"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Media.Artist}" FontSize="10"
                                       Foreground="{StaticResource TextSecondary}" MaxWidth="128"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>

                        <controls:WaveformControl Grid.Column="2" AudioSource="{Binding Equalizer}"
                                                  Width="44" Height="18" VerticalAlignment="Center"
                                                  IsHitTestVisible="False" Margin="0,0,2,0" />

                        <Border Grid.Column="3" Height="20" MinWidth="22" CornerRadius="10"
                                Background="#20FFFFFF" Margin="2,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding HasShelfItems, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5,0,6,0">
                                <Path Data="{StaticResource IconClip}" Width="9" Height="9" Stretch="Uniform"
                                      Stroke="{StaticResource TextSecondary}" StrokeThickness="1.4" />
                                <TextBlock Text="{Binding ShelfCount}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" Margin="3,0,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Раскрытый режим -->
                    <Grid x:Name="ExpandedRoot" Margin="20,14,20,12" Opacity="0" IsHitTestVisible="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Шапка -->
                        <Grid Grid.Row="0" Height="20">
                            <TextBlock Text="{Binding Media.Source}" Style="{StaticResource Caption}"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource TinyButton}" Click="PinButton_Click"
                                        ToolTip="Закрепить / открепить">
                                    <Path Data="{StaticResource IconPin}" Width="12" Height="12" Stretch="Uniform"
                                          Stroke="{StaticResource TextSecondary}" StrokeThickness="1.4" />
                                </Button>
                                <Button Style="{StaticResource TinyButton}" Click="CollapseButton_Click"
                                        ToolTip="Свернуть" Margin="2,0,0,0">
                                    <Path Data="{StaticResource IconChevron}" Width="12" Height="12" Stretch="Uniform"
                                          Stroke="{StaticResource TextSecondary}" StrokeThickness="1.6" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Трек -->
                        <Grid Grid.Row="1" Margin="0,10,0,0" Height="80">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="76" Height="76" CornerRadius="14" Background="#13FFFFFF"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="♫" FontSize="28" Foreground="#66707D"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding Media.Cover}" Stretch="UniformToFill">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,76,76" RadiusX="14" RadiusY="14" />
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Media.Title}" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Media.Artist}" FontSize="12.5"
                                           Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"
                                           Margin="0,5,0,0" />
                            </StackPanel>

                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Equalizer.Levels}"
                                          Width="42" Height="24" VerticalAlignment="Center" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="4" Margin="1,0,1,0" CornerRadius="2"
                                                VerticalAlignment="Bottom" Background="{StaticResource AccentBrush}"
                                                Height="{Binding Converter={StaticResource LevelToHeight}, ConverterParameter=20}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- Waveform и прогресс -->
                        <Border Grid.Row="2" Margin="0,8,0,0" Height="46" CornerRadius="12"
                                Background="#09FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1"
                                Padding="10,5,10,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="3" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <controls:WaveformControl AudioSource="{Binding Equalizer}"
                                                          VerticalAlignment="Stretch" IsHitTestVisible="False" />

                                <Border Grid.Row="1" Height="3" CornerRadius="2" Background="#20FFFFFF"
                                        Margin="2,2,2,1" ClipToBounds="True">
                                    <Border Background="{StaticResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Media.Progress}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>

                                <Grid Grid.Row="2" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Media.PositionText}" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Media.DurationText}" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Управление -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Style="{StaticResource PlayerButton}" Click="Previous_Click"
                                    IsEnabled="{Binding Media.CanPrevious}" ToolTip="Предыдущий трек">
                                <Path Data="{StaticResource IconPrevious}" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{StaticResource TextPrimary}" />
                            </Button>
                            <Button Style="{StaticResource PrimaryPlayerButton}" Click="PlayPause_Click"
                                    Margin="10,0,10,0" ToolTip="Пауза / воспроизведение">
                                <Grid>
                                    <Path Data="{StaticResource IconPause}" Width="16" Height="16" Stretch="Uniform"
                                          Fill="#FF111318"
                                          Visibility="{Binding Media.IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                                    <Path Data="{StaticResource IconPlay}" Width="16" Height="16" Stretch="Uniform"
                                          Fill="#FF111318"
                                          Visibility="{Binding Media.IsPlaying, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource PlayerButton}" Click="Next_Click"
                                    IsEnabled="{Binding Media.CanNext}" ToolTip="Следующий трек">
                                <Path Data="{StaticResource IconNext}" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{StaticResource TextPrimary}" />
                            </Button>
                        </StackPanel>

                        <!-- Полка -->
                        <StackPanel Grid.Row="4" Margin="0,10,0,0">
                            <Rectangle Height="1" Fill="#14FFFFFF" />
                            <TextBlock Text="ФАЙЛЫ" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="5" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasShelfItems, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Shelf}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#11FFFFFF" CornerRadius="10" Padding="6,4,4,4"
                                                Margin="0,0,6,6" Cursor="Hand" ToolTip="{Binding Path}"
                                                PreviewMouseLeftButtonDown="Chip_PreviewMouseLeftButtonDown"
                                                MouseMove="Chip_MouseMove"
                                                MouseLeftButtonUp="Chip_MouseLeftButtonUp">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Icon}" Width="16" Height="16"
                                                       VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="10.5"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               MaxWidth="122" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SizeText}" FontSize="9"
                                                               Foreground="{StaticResource TextDim}" Margin="0,1,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource TinyButton}"
                                                        Width="18" Height="18" Tag="{Binding}"
                                                        Click="RemoveShelf_Click" ToolTip="Убрать с полки">
                                                    <Path Data="{StaticResource IconClose}" Width="8" Height="8"
                                                          Stretch="Uniform" Stroke="{StaticResource TextSecondary}"
                                                          StrokeThickness="1.5" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Border.ContextMenu>
                <ContextMenu Background="#FF14151A" Foreground="{StaticResource TextPrimary}"
                             BorderBrush="#24FFFFFF" BorderThickness="1">
                    <MenuItem Header="Показать / скрыть" Click="MenuToggle_Click" />
                    <MenuItem Header="Закрепить островок" Click="MenuPin_Click" />
                    <Separator />
                    <MenuItem Header="Выход" Click="MenuExit_Click" />
                </ContextMenu>
            </Border.ContextMenu>
        </Border>

        <!-- Подсветка при перетаскивании -->
        <Border x:Name="DropOutline" Margin="8" CornerRadius="30" BorderThickness="1"
                BorderBrush="{StaticResource AccentBrush}" Opacity="0" IsHitTestVisible="False" />
    </Grid>
</Window>
